# Copy to .env and fill in. Never commit the real .env (it's in .gitignore).

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 1 = fake AI answers, to test the screen without spending credits
MIRROR_DEMO=0

# Answer language
MIRROR_LANGUAGE=Brazilian Portuguese

# Your location for the weather (default: São Paulo)
MIRROR_LAT=-23.55
MIRROR_LON=-46.63
MIRROR_TZ=America/Sao_Paulo

# auto | picamera | usb | file
MIRROR_CAMERA=auto
# Degrees to rotate the camera image (0, 90, 180, 270) if the camera is mounted sideways
MIRROR_CAMERA_ROTATE=0

# GPIO pin (BCM) of a physical push button; 0 = no button
MIRROR_BUTTON_PIN=0

# low = fastest; medium/high = more careful answers but slower
MIRROR_EFFORT=low
